# Force all marketplaces back to generated sample data.
# USE_MOCK_MARKETPLACES=1

# --- eBay sold comps (required for live eBay sold panel) ---
# Create a key at https://sold-comps.com → Dashboard. Free tier: 100 searches/mo.
SOLD_COMPS_API_KEY=

# eBay speed vs depth (SoldComps scrapes eBay per request — smaller = faster).
# EBAY_SOLD_COMPS_MAX_LISTINGS=30
# EBAY_SOLD_COMPS_MAX_PAGES=1

# --- eBay active listings (required for live eBay active panel) ---
# Production keys from https://developer.ebay.com → Application keys (OAuth Client ID + Cert ID).
# Enable the Buy API for the app. Uses Browse API item_summary/search.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_MARKETPLACE_ID=EBAY_US
# EBAY_BROWSE_MAX_LISTINGS=60
# EBAY_SANDBOX=0

# --- Grailed (public Algolia search keys; override if Grailed rotates them) ---
# GRAILED_ALGOLIA_APP_ID=MNRWEFSS2Q
# GRAILED_ALGOLIA_API_KEY=
# GRAILED_MAX_LISTINGS=24

# --- Mercari (Cloudflare blocks server fetch; default is link-out) ---
MERCARI_LINK_OUT=1
# MERCARI_LINK_OUT=0
# MERCARI_MAX_LISTINGS=24

# --- Depop (personal use: link-out is the supported default) ---
# In-app Depop listings need Bright Data Web Unlocker + business KYC on Depop (policy_20050).
# Most hobby resellers should leave live Depop off and use the "Search Depop" link on the card.
DEPO_LINK_OUT=1
# Optional — only if Bright Data approved Depop on a business account:
# DEPO_LINK_OUT=0
# BRIGHTDATA_API_KEY=
# BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1
# BRIGHTDATA_COUNTRY=us
# BRIGHTDATA_RENDER=true
# DEPOP_MAX_LISTINGS=24

# Cache identical live searches (seconds). Default 21600 (6h). 0 = off.
# SEARCH_CACHE_REVALIDATE_SECONDS=21600
